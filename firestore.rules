rules_version = '2';

// =====================================================
//  FoodShare – Firestore biztonsági szabályok
//  Ezt a szöveget a Firebase konzolban kell bemásolni:
//  Firestore Database -> Rules -> (mindent törölj ki, ezt illeszd be) -> Publish
//  Admin: alexcofari1265@gmail.com
// =====================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == "alexcofari1265@gmail.com";
    }

    // Automaták: mindenki láthatja, csak az admin módosíthatja
    match /lockers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Adományok: mindenki láthatja; bejelentkezett (akár névtelen) felhasználó hozhat létre és módosíthat
    match /donations/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasAll(["id", "title", "category", "portions", "lockerId", "status"])
        && request.resource.data.portions is number
        && request.resource.data.portions > 0
        && request.resource.data.portions < 1000;
      // Törölni csak az admin tud, vagy bárki a még be nem töltött (visszavont) adományt
      allow delete: if isAdmin() || (signedIn() && resource.data.status == "waiting");
    }

    // Érdeklődő cégek: bárki beküldhet, de csak az admin láthatja (személyes adatok!)
    match /leads/{id} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }
  }
}
